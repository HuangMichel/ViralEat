# Copy to .env (ignored by git) and fill in. No default is guessed for keys or model.

OPENAI_API_KEY=
# A model available on your account that supports structured outputs.
OPENAI_MODEL=
# low | medium | high, or empty to not send the parameter.
OPENAI_REASONING_EFFORT=

ORIANE_API_KEY=
ORIANE_BASE_URL=https://connect.oriane.xyz
# The Oriane docs do not state the auth convention: copy it from your account instructions.
# Example shapes: header "Authorization" + prefix "Bearer", or header "X-API-Key" + empty prefix.
# The space between prefix and key is added by the code.
ORIANE_AUTH_HEADER=
ORIANE_AUTH_PREFIX=

# JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

# Max contents collected per analysis (all restaurants together for a benchmark).
MAX_CONTENTS=100
# Parallel OpenAI extraction calls.
EXTRACTION_CONCURRENCY=4
