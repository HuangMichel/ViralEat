# ViralEat configuration template.
# Proposed application settings; no configuration loader exists yet.
# Fill required blank values before running real integrations.

# Frontend: these values are public. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend
APP_ENV=development
APP_NAME=ViralEat
API_PREFIX=/v1
API_CORS_ORIGINS='["http://localhost:3000"]'
APP_TIMEZONE=Europe/Paris
LOG_LEVEL=INFO

# Supabase email/password Auth and user-JWT Data API access
# Enable email confirmation and configure Site URL, allowed redirects, and custom
# SMTP in Supabase Auth settings. These are not configured by this file.
# SMTP credentials belong in Supabase settings, not the frontend or this template.
# Use values from the selected project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Backend SQL: restricted role through the transaction pooler.
DATABASE_URL=
DATABASE_POOL_SIZE=1
DATABASE_PREPARED_STATEMENTS=false
# Validate certificate settings with the selected driver and provider.
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=

# Oriane: confirm authentication against the API account instructions.
ORIANE_BASE_URL=https://connect.oriane.xyz
ORIANE_API_KEY=
ORIANE_AUTH_HEADER=
# Leave empty only if Oriane confirms the key needs no prefix.
ORIANE_AUTH_SCHEME=
ORIANE_CONTENT_PROJECTION=full
ORIANE_PAGE_SIZE=100
ORIANE_REQUEST_TIMEOUT_SECONDS=30
# Proposed application caps, not provider quotas or monetary estimates.
ORIANE_MAX_REQUESTS_PER_ANALYSIS=10
ORIANE_CREDIT_BUDGET_PER_ANALYSIS=200
USAGE_MAX_DAILY_ORIANE_CREDITS_PER_WORKSPACE=200

# AI extraction: configure an accessible model with structured output support.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_TOKENS_PER_CONTENT=12000
LLM_MAX_OUTPUT_TOKENS=4096
USAGE_MAX_LLM_TOKENS_PER_ANALYSIS=300000
LLM_PROMPT_VERSION=v1
EXTRACTION_SCHEMA_VERSION=v1
# Enable only after checking image access, processing rights, and model support.
LLM_ANALYZE_FRAMES=false

# Queue: local is for development and tests; deployment requires vercel.
# Both adapters still need implementation.
QUEUE_PROVIDER=local
QUEUE_TOPIC=restaurant-analysis
QUEUE_MAINTENANCE_TOPIC=restaurant-maintenance
QUEUE_CONSUMER_GROUP=restaurant-analysis-v1
# Select a region compatible with the deployment and database.
QUEUE_REGION=
# Vercel-managed credentials are not copied into this template.
JOB_MAX_ATTEMPTS=3
JOB_MAX_CONCURRENCY=2
JOB_STEP_TIMEOUT_SECONDS=120
JOB_RETRY_BASE_SECONDS=10
JOB_RETRY_MAX_SECONDS=120
ANALYSIS_MAX_ACTIVE_PER_WORKSPACE=1

# Collection targets and cache
DEFAULT_ANALYSIS_WINDOW_DAYS=30
BENCHMARK_COMPETITOR_COUNT=4
# Targets are ceilings for collection, not guaranteed result counts.
BENCHMARK_TARGET_CONTENTS=100
MARKET_TARGET_CONTENTS=100
DATA_REFRESH_MIN_INTERVAL_MINUTES=60
# Proposed duration; confirm permitted retention before real collection.
RAW_CONTENT_RETENTION_DAYS=30

# Feature flags do not implement or validate the corresponding capability.
FEATURE_MARKET_WATCH=true
FEATURE_GUIDED_QUESTIONS=false
# Future capabilities, outside the initial core.
FEATURE_FREE_CHAT=false
FEATURE_SOCIAL_OAUTH=false
FEATURE_SCHEDULED_REFRESH=false
